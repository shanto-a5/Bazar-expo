{
  "name": "vanta-api",
  "version": "1.0.0",
  "private": true,
  "description": "Vanta marketplace API (M7). Express + MongoDB, authoritative for auth, catalog, cart, orders and seller operations.",
  "main": "dist/backend/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "dev": "npm run build && node dist/backend/src/server.js",
    "seed": "npm run build && node dist/backend/src/seed/seed-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/backend/src/tests/run.js",
    "test:mongo": "npm run build && node dist/backend/src/tests-mongo/run.js",
    "test:all": "npm run test && npm run test:mongo"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.12",
    "mongodb-memory-server": "^10.1.4",
    "typescript": "^5.7.3"
  }
}
