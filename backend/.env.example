# Vanta API — environment template (M8)
#
# Copy to `.env` for local server runs. `.env` is git-ignored and MUST never be
# committed. Nothing in this file belongs in the Expo app bundle: the client is
# configured only with the build-time `EXPO_PUBLIC_API_MODE` and
# `EXPO_PUBLIC_API_BASE_URL` (see ../src/config/runtime-config.ts).
#
# Every value below is validated at boot. In production the server refuses to
# start on a wildcard CORS origin, an empty allowlist, the `console` mail
# transport, the `smtp` mail transport (no SMTP client is bundled), the default
# test sender, a missing MONGO_URI, startup seeding, a weak SESSION_SECRET, or
# MONGO_TRANSACTIONS=true against a database that cannot commit transactions.
# Those rules are enforced by backend/src/tests/config.test.ts, which boots this
# server for real rather than inspecting its own config object.

# --- server ---
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API. "*" is rejected in production.
CORS_ORIGINS=http://127.0.0.1:8099,http://localhost:8081,http://localhost:19006
# Max JSON body size accepted by the API.
BODY_LIMIT=100kb

# --- database ---
# Required in production. In development the server refuses to start without a
# value unless ALLOW_MEMORY_DB=true is set explicitly.
MONGO_URI=mongodb://127.0.0.1:27017/vanta
ALLOW_MEMORY_DB=true
# M8: checkout runs as one multi-document transaction when true. A standalone
# mongod cannot do that, so development against one should set this to false and
# rely on compensating writes — /health/ready reports which mode is live.
# In production, true against a non-transactional topology is a startup failure
# rather than a silent downgrade.
MONGO_TRANSACTIONS=false

# --- auth ---
# Server-side only. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never ship this to a client. Rotating it invalidates every issued session.
SESSION_SECRET=dev-only-change-me
SESSION_TTL_DAYS=30
# M8: cap on concurrent live sessions per account. 0 means no cap, and is a real
# accepted value rather than a rejected one.
SESSION_MAX_PER_USER=10
# bcrypt cost factor. 12 is the development default; use >= 12 everywhere.
BCRYPT_ROUNDS=12

# --- abuse protection ---
# Fixed-window limiter, per client IP, applied to credential + write routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=10
# M8: password-reset routes have their own, much tighter budget, because they send
# mail and are otherwise an unauthenticated way to make the server do work.
PASSWORD_RESET_RATE_LIMIT_MAX=5

# --- mail (M8) ---
# A password reset is only real if something can carry the token, so the transport
# is part of the production contract.
#   console — development only; writes the reset link to stdout.
#   http    — POSTs to MAIL_HTTP_ENDPOINT. The only option production accepts.
#   smtp    — declared in the type union but not implemented in this build, and
#             rejected at startup in production rather than failing later.
MAIL_PROVIDER=console
MAIL_FROM=no-reply@vanta.test
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_API_KEY=
# M8: the app route the mailed reset link points at. The token arrives as
# ?token=..., which /reset-password reads on mount.
PUBLIC_APP_URL=http://127.0.0.1:8099/reset-password
# M8: how long a reset token stays usable, in minutes. Tokens are single-use and
# stored hashed, so this window is the whole exposure.
PASSWORD_RESET_TTL_MINUTES=30

# --- idempotency (M8) ---
# How long a spent checkout idempotency key is remembered, in hours. A retry inside
# this window replays the original order; after it, the key is reusable. The TTL
# index is what enforces this — the records are never swept in application code.
IDEMPOTENCY_TTL_HOURS=24

# --- seeding ---
# Deterministic dataset only; never production data.
SEED_ON_START=false
