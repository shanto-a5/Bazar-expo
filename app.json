{
  "expo": {
    "name": "Bazar",
    "slug": "vanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vanta",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/images/bazar-android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bazar-android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kader95.vanta"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bazar uses your location to fill in your delivery address and speed up checkout."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8fa6ce0-1988-4786-b1c7-1b3409e8e96b"
      }
    }
  }
}
