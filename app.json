{
  "expo": {
    "name": "Bazar",
    "slug": "samrat-bazar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vanta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kader95.vanta"
    },
    "android": {
      "icon": "./assets/images/bazar-android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bazar-android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kader95.vanta",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bazar uses your location to fill in your delivery address and speed up checkout."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c1e14728-434b-45f1-8fc2-83e408123259"
      }
    }
  }
}
